<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: cleartext permitted so a test server on the LAN
     (http://192.168.x.x) can be used. Release builds use src/main's config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
