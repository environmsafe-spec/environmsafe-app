# Public settings for the live app. Copy to .env.production and fill in.
# Only the PUBLIC (publishable / anon) key goes here – never the service key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
VITE_PUBLIC_URL=https://records.environmsafe.com
SUPABASE_REGION=eu-west-2
